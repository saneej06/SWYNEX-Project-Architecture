# Copy to .env and use your own local values. NEVER commit .env
PORT=4000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/pricepulse
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
CLIENT_ORIGIN=http://localhost:5173
# Optional admin setup (used only by npm run create-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=set_a_strong_private_password
ADMIN_NAME=PricePulse Admin
